    "html": "<div style=\"font-family:Arial, Helvetica, sans-serif;font-size:10px;font-weight:400;font-style:normal;line-height:normal;letter-spacing:normal;color:rgb(0, 0, 0);text-align:start;text-transform:none;text-shadow:rgba(0, 0, 0, 0) 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px;white-space:normal;word-spacing:0px;direction:ltr;text-indent:0px;list-style-type:disc;list-style-position:outside;box-sizing:border-box;width:100%\"><h5 style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:20px;line-height:24px;color:rgb(99, 99, 99)\"><span style=\"font-weight:700\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\"><a href=\"tel:28.09. - 02.10\" style=\"\">28.09. - 02.10</a>. + <a href=\"tel:05.10. - 09.10\" style=\"\">05.10. - 09.10</a>.: &nbsp;Herbstcamps</span></span></h5>\n\n<p style=\"font-family:verdana, geneva, sans-serif;font-size:14px;line-height:18.2px;color:rgb(99, 99, 99)\"><span style=\"font-size:13px\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">(Anmeldefrist für beide Camps ist der 20. September)</span></span></p>\n\n<p style=\"font-family:verdana, geneva, sans-serif;font-size:13px;line-height:16.9px;color:rgb(99, 99, 99)\">&nbsp;</p>\n\n<p style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">Die Preise zu den Camps findet ihr unter Anmeldungen und Camps.</span></p>\n\n<p style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">Mit den letzten beiden Camps hört die offizielle Sommersaison des Kinder- und Junioren-Trainings dann auf. Einzel- und Gruppenkurse gehen danach natürlich weiter, solange es das Wetter erlaubt. Danach wird das Mittwochs- Kindertraining während der Wintersaison in die 99er-Sporthalle in Therwil verlegt.&nbsp;</span></p>\n\n<p style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\">​</p></div>"
