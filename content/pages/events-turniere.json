   "w": 404,
   "h": 255,
   "html": "<div style=\"font-family:Arial, Helvetica, sans-serif;font-size:10px;font-weight:400;font-style:normal;line-height:normal;letter-spacing:normal;color:rgb(0, 0, 0);text-align:start;text-transform:none;text-shadow:rgba(0, 0, 0, 0) 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px;white-space:normal;word-spacing:0px;direction:ltr;text-indent:0px;display:block;width:100%\"><h5 style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:20px;line-height:24px;color:rgb(99, 99, 99)\"><span><span><span style=\"font-weight:700\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">29.06. - 03.07. und 03. - 07.08.: &nbsp;Sommercamps</span></span></span></span></h5>\n\n<p style=\"font-family:verdana, geneva, sans-serif;font-size:13px;line-height:16.9px;color:rgb(99, 99, 99)\"><span><span><span><span><span style=\"font-size:12px\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">(Anmeldefrist 1.&nbsp;</span></span><span style=\"font-size:12px\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">Camp: 19.06.; Anmeldefrist </span></span><span style=\"font-family:&quot;times new roman&quot;, times, serif\"><span style=\"font-size:12px\">2. Camp: 25.07</span><span style=\"font-size:12px\">.</span></span><span style=\"font-size:12px\"><span style=\"font-family:&quot;times new roman&quot;, times, serif\">)</span></span></span></span></span></span></p>\n\n<p style=\"font-family:verdana, geneva, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\">&nbsp;</p>\n\n<p style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\"><span><span><span style=\"font-family:&quot;times new roman&quot;, times, serif\">Während der Sommerferien finden die Sommercamps der Tennisschule statt. Geeignet für Einsteiger bis hin zum geübten Spieler um eine (oder zwei) Woche(n) lang(Mo-Fr) mit gleichgesinnten eine tolle Tenniszeit zu verbringen. Wir trainieren, spielen Matches, lernen Technik und Taktik im Einzel und Doppel und wer will kann </span></span><span style=\"font-family:&quot;times new roman&quot;, times, serif\"><span>dort&nbsp;</span></span><span><span style=\"font-family:&quot;times new roman&quot;, times, serif\">auch zu Mittag essen.&nbsp;</span></span></span></p>\n\n<p style=\"font-family:&quot;open sans&quot;, sans-serif;font-size:17px;line-height:20.4px;color:rgb(99, 99, 99)\"><span><span><span style=\"font-family:&quot;times new roman&quot;, times, serif\">Daten, Optionen samt Preise hierzu findet ihr unter Anmeldungen und Camps.</span></span></span></p></div>"
  },
